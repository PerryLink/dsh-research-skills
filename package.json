{
  "name": "dsh-research-skills",
  "version": "0.1.0",
  "description": "Seven research SOP skills for DeepSeek Harness: literature review, citation audit, claim/evidence audit, manuscript preflight, reviewer response, reproducibility audit and data-management planning. Each skill ends in a REP record or an explicit verdict, never in prose alone.",
  "author": "PerryLink contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-research-skills.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-research-skills#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-research-skills/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README-zh.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "research",
    "systematic-review",
    "reproducibility"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.1-0 <0.3.0 || >=0.2.2-0 <0.3.0"
  },
  "packageManager": "pnpm@12.16.1",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check:lockfile": "node scripts/check-lockfile-drift.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  }
}
